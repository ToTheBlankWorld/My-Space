    "@space/logger": "workspace:*",
    "@space/time": "workspace:*",
    "@space/types": "workspace:*",
    "@space/validation": "workspace:*",
    "pg": "^8.23.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@space/eslint-config": "workspace:*",
    "@space/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "catalog:",
    "vitest": "catalog:"
