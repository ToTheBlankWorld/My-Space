# ---------------------------------------------------------------------------
# @space/worker — background runtime (deployed to Railway)
#
# Copy to `.env` for local development. Every variable below has a default, so
# the worker boots with no `.env` file at all. Never commit a real `.env`.
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Identifies this process in logs and, later, in queue consumer names.
WORKER_NAME=space-worker

# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# Port for the health endpoints polled by the deployment platform.
HEALTH_PORT=8080

# Milliseconds given to in-flight work during a graceful shutdown.
SHUTDOWN_TIMEOUT_MS=10000

# Optional PostgreSQL connection. When set, the worker opens a pool at boot and
# reports database reachability through /readyz. When absent it still boots.
# DATABASE_URL=postgresql://space:space@localhost:5432/space_dev

# ---------------------------------------------------------------------------
# Stage 04: queue + calendar sync (BullMQ workers)
# ---------------------------------------------------------------------------
# Redis connection for the queue consumers. Without it the worker boots without
# the calendar sync and maintenance workers.
# REDIS_URL=rediss://default:password@host:6379

# How often (in minutes) automatic calendar sync runs for connected accounts.
# Minimum 5, default 15.
# CALENDAR_SYNC_INTERVAL_MINUTES=15

# Google OAuth client used only to refresh calendar access tokens. The consent
# flow itself runs in the web app; the worker only refreshes.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Per-deployment AEAD key used to decrypt stored calendar tokens.
# Format: <keyId>:<base64(32-byte key)>. Same values as the web app uses.
# OAUTH_ENCRYPTION_KEY=
# OAUTH_ENCRYPTION_PREVIOUS_KEYS=

# ---------------------------------------------------------------------------
# Stage 07: notification engine (BullMQ workers)
# ---------------------------------------------------------------------------
# Public base URL of the web app; used to build clickable links in emails.
# APP_URL=http://localhost:3000

# AgentMail API key used by the email delivery provider. Without it the worker
# boots, but outbound email attempts are recorded as failed and never faked.
# AGENTMAIL_API_KEY=

# AgentMail API base URL. Change to a sandbox while testing locally.
# AGENTMAIL_BASE_URL=https://api.agentmail.dev

# How often (in minutes) the notification sweep runs. Minimum 1, default 5.
# NOTIFICATION_SWEEP_INTERVAL_MINUTES=5

# ---------------------------------------------------------------------------
# Stage 08: autonomous space loop (BullMQ workers)
# ---------------------------------------------------------------------------
# How often (in minutes) the autonomy review runs: observes real-world signals,
# detects at-risk deadlines, classifies calendar drift, and delegates replans.
# Minimum 1, default 5.
# AUTONOMY_REVIEW_INTERVAL_MINUTES=5

# ---------------------------------------------------------------------------
# Reserved for later stages — do not set yet, nothing reads them.
# ---------------------------------------------------------------------------
# DIRECT_DATABASE_URL=
# SENTRY_DSN=
