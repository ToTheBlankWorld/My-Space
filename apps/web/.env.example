# ---------------------------------------------------------------------------
# @space/web — Next.js application (deployed to Vercel)
#
# Copy to `.env.local` for local development. Never commit a real env file.
#
# Rules:
#   * Anything WITHOUT the NEXT_PUBLIC_ prefix stays on the server.
#   * Anything WITH the NEXT_PUBLIC_ prefix is inlined into the browser bundle
#     and is therefore public. Never put a credential behind that prefix.
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Public origin of this deployment. Used for absolute URLs and page metadata.
APP_URL=http://localhost:3000

# --- persistence (Supabase PostgreSQL) --------------------------------------
# DATABASE_URL=postgresql://space:space@localhost:5432/space_dev
# DIRECT_DATABASE_URL=postgresql://user:password@host:5432/postgres
# DATABASE_LOG_QUERIES=false
# DATABASE_HEALTH_TIMEOUT_MS=2000

# --- auth -------------------------------------------------------------------
# AUTH_SECRET=                  # >= 32 characters; the better-auth session signing secret
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# Per-deployment AEAD key for encrypting stored OAuth tokens.
# Format: <keyId>:<base64(32-byte key)>. Generate with:
#   node -e "const k=crypto.randomUUID().slice(0,12); const b=crypto.randomBytes(32).toString('base64'); console.log(k+':'+b)"
#
# OAUTH_ENCRYPTION_KEY=
# OAUTH_ENCRYPTION_PREVIOUS_KEYS=

# --- calendar sync ----------------------------------------------------------
# How often (in minutes) the worker's automatic calendar sync runs for
# connected accounts. The web app only writes the durable schedule row.
# CALENDAR_SYNC_INTERVAL_MINUTES=15

# --- end-to-end auth (test-only; do not set in production) ------------------
# E2E_AUTH_ENABLED=true
# E2E_AUTH_SECRET=            # >= 32 chars; deterministic test identity

# --- later stages ----------------------------------------------------------
# AGENTMAIL_API_KEY=
# SENTRY_DSN=