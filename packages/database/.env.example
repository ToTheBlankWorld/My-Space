# ---------------------------------------------------------------------------
# @space/database — persistence layer
#
# Copy to `packages/database/.env` for local development. Prisma's CLI reads
# this file; the applications read their own environment.
#
# Never commit a real `.env`. A connection string is a credential.
# ---------------------------------------------------------------------------

# Pooled connection used by the applications.
# Local (docker compose up -d postgres):
DATABASE_URL=postgresql://space:space@localhost:5432/space_dev
# Supabase production shape (PgBouncer, port 6543):
# DATABASE_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Direct, unpooled connection used by `prisma migrate` and introspection.
# Transaction pooling cannot hold the advisory lock migrations need, so this
# must point at the database itself, not at the pooler.
# Local: identical to DATABASE_URL, so it can be omitted.
# DIRECT_DATABASE_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# Log one record per SQL statement. Local debugging only. Statement text is
# logged; bound parameters never are.
DATABASE_LOG_QUERIES=false

# Milliseconds a health probe waits before declaring the database unreachable.
DATABASE_HEALTH_TIMEOUT_MS=2000

# ---------------------------------------------------------------------------
# Integration tests
#
# Point at a database you are willing to have rows written to and deleted from.
# Without it, `pnpm test:integration` skips every test instead of failing.
# ---------------------------------------------------------------------------
# TEST_DATABASE_URL=postgresql://space:space@localhost:5432/space_test
