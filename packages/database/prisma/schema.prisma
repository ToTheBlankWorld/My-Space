// =============================================================================
// Space — persistence schema
//
// Conventions that hold for every model in this file:
//
//   * Identifiers are cuid2. They are unguessable, k-sortable enough for
//     cursor pagination, and safe to expose in a URL.
//   * Every column that represents an *instant* is `Timestamptz(3)`. PostgreSQL
//     stores it in UTC and returns it with an offset, so no reader can
//     accidentally reinterpret it in the server's local zone.
//   * A column that represents a *calendar date* (the day a Space belongs to) is
//     `@db.Date`. It has no time and no offset, because a day is not an instant.
//   * A column that represents a *time of day* is an integer count of minutes
//     since local midnight, not a timestamp: "remind me at 08:30" must survive a
//     DST change and a move between timezones.
//   * User-owned rows carry `userId` and cascade on user deletion, so erasing an
//     account erases their data in one statement.
//   * Enums mirror `@space/types` exactly. A drift test asserts this.
// =============================================================================

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

// Prisma 7 moved connection URLs out of the schema. They live in
// `prisma.config.ts` for the CLI, and are supplied to `PrismaClient` through a
// driver adapter at runtime — so a connection string is never baked into a
// generated artefact.
datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AutonomyLevel {
  SUGGEST_ONLY
  ASK_BEFORE_CHANGING
  AUTOMATICALLY_MANAGE
}

enum SchedulingStrategy {
  EARLIEST_FIT
  BALANCED
  DEADLINE_FIRST
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum SpaceStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum SpaceItemKind {
  TASK
  REMINDER
  CALENDAR_EVENT
}

enum TaskPriority {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

enum TaskStatus {
  INBOX
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  MISSED
  RESCHEDULED
}

enum ReminderStatus {
  PENDING
  COMPLETED
  CANCELLED
  MISSED
}

enum DeliveryState {
  PENDING
  QUEUED
  SENT
  FAILED
  SKIPPED
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  PAUSED
  ABANDONED
}

enum CalendarProvider {
  GOOGLE
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum CalendarEventStatus {
  CONFIRMED
  TENTATIVE
  CANCELLED
}

enum SyncState {
  SYNCED
  PENDING_PUSH
  PENDING_PULL
  CONFLICT
  FAILED
}

enum NotificationType {
  DAILY_PLAN
  TASK_REMINDER
  DEADLINE_WARNING
  SCHEDULE_CHANGE
  SYSTEM
}

enum NotificationPriority {
  CRITICAL
  IMPORTANT
  NORMAL
  SILENT
}

enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  FAILED
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  DEAD
  CANCELLED
