# ---------------------------------------------------------------------------
# Space - environment reference
#
# This file documents every variable the system will use. It is a reference,
# not a runtime file: each application reads its own env file.
#
#   apps/web/.env.example     -> copy to apps/web/.env.local
#   apps/worker/.env.example  -> copy to apps/worker/.env
#
# Never commit a real .env file. Never put a credential behind NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# --- required ---------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
WORKER_NAME=space-worker
LOG_LEVEL=debug
HEALTH_PORT=8080
SHUTDOWN_TIMEOUT_MS=10000

# --- persistence (Supabase PostgreSQL) --------------------------------------
# Read by @space/database, and optionally by the worker.
# Pooled connection used by the applications.
DATABASE_URL=postgresql://space:space@localhost:5432/space_dev
# Direct, unpooled connection used by migrations. Optional locally — falls
# back to DATABASE_URL when absent.
# DIRECT_DATABASE_URL=postgresql://user:password@host:5432/postgres
DATABASE_LOG_QUERIES=false
DATABASE_HEALTH_TIMEOUT_MS=2000
# Database used by the integration test suite. Absent means the suite skips.
# TEST_DATABASE_URL=postgresql://space:space@localhost:5432/space_test

# --- stage 03: auth --------------------------------------------------------
# Session signing secret. >= 32 characters; a long random string, not a base64
# key. The auth library uses this to sign session tokens with HMAC-SHA-256.
AUTH_SECRET=

# Google OAuth 2.0 credentials. Credentials are created in the Google Cloud
# Console under APIs & Services → Credentials → OAuth consent screen + client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Per-deployment encryption key for third-party credential storage.
# Format: <keyId>:<base64(32-byte key)>. Generate with:
#   node -e "const k=crypto.randomUUID().slice(0,12); const b=crypto.randomBytes(32).toString('base64'); console.log(k+':'+b)"
#
# OAUTH_ENCRYPTION_KEY=
# OAUTH_ENCRYPTION_PREVIOUS_KEYS=

# --- stage 03: end-to-end auth (test-only; never set in production) --------
# E2E_AUTH_ENABLED=true
# E2E_AUTH_SECRET=              # >= 32 chars; the test route uses this to sign in

# --- stage 04: queue (Upstash Redis + BullMQ) ------------------------------
# REDIS_URL=rediss://default:password@host:6379

# --- stage 04: AgentMail ---------------------------------------------------
# AGENTMAIL_API_KEY=

# --- later: observability --------------------------------------------------
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=